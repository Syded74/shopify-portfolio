<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Styleup</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #efefee;
        --panel: #f5f2ef;
        --card: #f7f4f2;
        --ink: #1b1d1f;
        --muted: #69707b;
        --line: rgba(18, 18, 18, 0.14);
        --red: #cc4b3b;
        --red-deep: #be3d32;
        --sand: #d8c2b7;
        --soft: rgba(255,255,255,0.45);
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Inter", sans-serif;
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .site-shell {
        max-width: 1480px;
        margin: 0 auto;
        background: var(--bg);
      }

      .topbar {
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .nav {
        max-width: 1480px;
        margin: 0 auto;
        padding: 18px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: -0.06em;
        font-family: "Cormorant Garamond", serif;
      }

      .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        font-size: 0.72rem;
        letter-spacing: 0.18rem;
        text-transform: uppercase;
        color: rgba(27,29,31,0.82);
      }

      .nav-links a {
        position: relative;
        padding-bottom: 6px;
      }

      .nav-links a.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: var(--red);
      }

      .nav-icons {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        color: var(--ink);
      }

      .icon {
        width: 18px;
        height: 18px;
        position: relative;
        display: inline-block;
      }

      .icon.search::before {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        border: 2px solid #1f2328;
        border-radius: 50%;
        left: 0;
        top: 0;
      }

      .icon.search::after {
        content: "";
        position: absolute;
        width: 8px;
        height: 2px;
        background: #1f2328;
        transform: rotate(45deg);
        right: 0;
        bottom: 1px;
      }

      .icon.user::before,
      .icon.user::after,
      .icon.bag::before,
      .icon.bag::after {
        content: "";
        position: absolute;
      }

      .icon.user::before {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #1f2328;
        left: 4px;
        top: 0;
      }

      .icon.user::after {
        width: 14px;
        height: 8px;
        border-radius: 8px 8px 6px 6px;
        background: #1f2328;
        left: 2px;
        bottom: 0;
      }

      .icon.bag::before {
        width: 14px;
        height: 10px;
        border: 2px solid #1f2328;
        border-radius: 3px 3px 4px 4px;
        left: 2px;
        top: 4px;
      }

      .icon.bag::after {
        width: 8px;
        height: 6px;
        border: 2px solid #1f2328;
        border-top: none;
        border-radius: 0 0 7px 7px;
        left: 5px;
        top: 0;
      }

      .hero {
        position: relative;
        margin: 0 auto;
        width: calc(100% - 32px);
        max-width: 1480px;
        min-height: 720px;
        background: linear-gradient(90deg, rgba(92,77,74,0.55) 0%, rgba(92,77,74,0.12) 38%, rgba(92,77,74,0.06) 100%);
        overflow: hidden;
      }

      .hero-media {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(90,73,68,.25) 0%, rgba(90,73,68,.18) 32%, rgba(90,73,68,.10) 100%),
          url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
        transform: scale(1.02);
      }

      .hero-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        padding: 112px 0 70px 80px;
      }

      h1 {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(4rem, 6vw, 7.25rem);
        line-height: 0.88;
        color: #f9f0ed;
        font-weight: 500;
        letter-spacing: -0.06em;
        margin: 0;
      }

      .hero-copy {
        max-width: 560px;
        margin-top: 22px;
        font-size: 1.1rem;
        line-height: 1.65;
        color: rgba(255,255,255,0.88);
      }

      .cta-row {
        margin-top: 28px;
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 170px;
        min-height: 54px;
        padding: 0 24px;
        border-radius: 10px;
        background: var(--red);
        color: #fff;
        font-weight: 600;
        font-size: 1.08rem;
        border: none;
      }

      .hero-control {
        position: absolute;
        right: 38px;
        bottom: 58px;
        display: flex;
        align-items: center;
        gap: 14px;
        z-index: 4;
      }

      .arrow {
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255,255,255,0.75);
        border-radius: 50%;
        position: relative;
        background: rgba(255,255,255,0.06);
      }

      .arrow::before {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        border-left: 2px solid rgba(255,255,255,0.9);
        border-bottom: 2px solid rgba(255,255,255,0.9);
        top: 15px;
      }

      .arrow.left::before {
        left: 16px;
        transform: rotate(45deg);
      }

      .arrow.right::before {
        left: 13px;
        transform: rotate(-135deg);
      }

      .promo-bar {
        background: var(--red);
        color: white;
        display: grid;
        grid-template-columns: repeat(5, minmax(180px, 1fr));
        align-items: center;
        gap: 0;
        min-height: 90px;
      }

      .promo-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 20px 12px;
        font-size: 0.88rem;
        letter-spacing: 0.12rem;
        text-transform: uppercase;
        font-weight: 600;
        border-left: 1px solid rgba(255,255,255,0.25);
      }

      .promo-item:first-child {
        border-left: none;
      }

      .promo-dot {
        width: 9px;
        height: 9px;
        background: rgba(255,255,255,0.85);
        border-radius: 50%;
        display: inline-block;
      }

      .promo-icon {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: rgba(255,255,255,0.15);
      }

      .content {
        max-width: 1480px;
        margin: 0 auto;
        padding: 52px 12px 80px;
      }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(260px, 1fr));
        gap: 28px;
        width: min(100%, 1320px);
        margin: 0 auto;
      }

      .card {
        background: var(--card);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.03);
        box-shadow: 0 14px 28px rgba(17, 22, 25, 0.04);
      }

      .card-image {
        height: 420px;
        background-size: cover;
        background-position: center;
      }

      .card:nth-child(1) .card-image {
        background-image: url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80');
      }

      .card:nth-child(2) .card-image {
        background-image: url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80');
      }

      .card:nth-child(3) .card-image {
        background-image: url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80');
      }

      .card:nth-child(4) .card-image {
        background-image: url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80');
      }

      @media (max-width: 900px) {
        .nav {
          padding: 14px 18px;
        }

        .nav-links {
          gap: 1rem;
          font-size: 0.62rem;
          letter-spacing: 0.11rem;
        }

        .hero {
          width: calc(100% - 18px);
          min-height: 610px;
        }

        .hero-content {
          padding: 72px 22px 50px;
          max-width: 100%;
        }

        .promo-bar {
          grid-template-columns: 1fr 1fr;
        }

        .product-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 640px) {
        .nav {
          flex-wrap: wrap;
          justify-content: center;
        }

        .nav-links {
          order: 3;
          width: 100%;
        }

        .hero {
          min-height: 520px;
        }

        .hero-copy {
          font-size: 1rem;
        }

        .promo-bar {
          grid-template-columns: 1fr;
        }

        .promo-item {
          justify-content: flex-start;
          padding-left: 26px;
        }

        .product-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <nav class="nav" aria-label="Main navigation">
          <div class="brand">Styleup</div>
          <div class="nav-links" aria-label="Navigation links">
            <a href="#" class="active">Home</a>
            <a href="#">Catalog</a>
            <a href="#">Contact</a>
          </div>
          <div class="nav-icons" aria-label="Account actions">
            <span class="icon search" aria-label="Search"></span>
            <span class="icon user" aria-label="Account"></span>
            <span class="icon bag" aria-label="Cart"></span>
          </div>
        </nav>
      </header>

      <main>
        <section class="hero" aria-label="Featured collection">
          <div class="hero-media" aria-hidden="true"></div>
          <div class="hero-content">
            <h1>Curated fashion for<br />the modern soul</h1>
            <p class="hero-copy">Refined pieces for the modern wardrobe where timeless design meets everyday comfort and effortless style.</p>
            <div class="cta-row">
              <a href="#" class="button">Shop the look</a>
            </div>
          </div>

          <div class="hero-control" aria-label="Slider controls">
            <span class="arrow left" aria-hidden="true"></span>
            <span class="arrow right" aria-hidden="true"></span>
          </div>
        </section>

        <section class="promo-bar" aria-label="Store benefits">
          <div class="promo-item"><span class="promo-dot"></span>Secure payment</div>
          <div class="promo-item"><span class="promo-icon">✦</span>Crafted with care</div>
          <div class="promo-item"><span class="promo-icon">✦</span>Free shipping</div>
          <div class="promo-item"><span class="promo-icon">✦</span>Limited edition</div>
          <div class="promo-item"><span class="promo-dot"></span>Fast delivery</div>
        </section>

        <div class="content">
          <div class="product-grid" aria-label="Featured products">
            <article class="card">
              <div class="card-image" aria-label="Feature product 1"></div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Feature product 2"></div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Feature product 3"></div>
            </article>
            <article class="card">
              <div class="card-image" aria-label="Feature product 4"></div>
            </article>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
